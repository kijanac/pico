[Unit]
Description=Pico host

[Service]
WorkingDirectory=%h/work/pico
# A small young generation keeps the heap ~50 MB smaller on a box shared with
# agents, for slightly more frequent minor GCs.
ExecStart=%h/.local/share/mise/installs/node/26/bin/node --max-semi-space-size=4 packages/host/dist/main.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PICO_OWNER=kijanac@github
Environment=PICO_HOST_DB=%h/.local/share/pico/pico-host.db
# The agent's bash tool inherits this PATH, so include mise's tools.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
