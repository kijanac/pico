  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@pico/protocol": "workspace:*",
    "@types/node": "^25.9.1",
    "typescript": "^5.9.0"
  }
